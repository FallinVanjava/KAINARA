erDiagram
    USERS {
        bigint id PK
        varchar name
        varchar email UK
        timestamp email_verified_at
        varchar password
        varchar remember_token
        timestamp created_at
        timestamp updated_at
    }

    TAPIS_MOTIFS {
        bigint id PK
        varchar name
        varchar slug UK
        varchar origin_region
        varchar dominant_color
        text description
        text history
        text philosophy
        varchar image_path
        timestamp created_at
        timestamp updated_at
    }

    OUTFITS {
        bigint id PK
        varchar name
        varchar slug UK
        enum category
        json skintone_match
        text description
        text mix_match_notes
        varchar image_path
        timestamp created_at
        timestamp updated_at
    }

    MOTIF_OUTFIT {
        bigint tapis_motif_id PK,FK
        bigint outfit_id PK,FK
    }

    CACHE {
        varchar key PK
        mediumtext value
        int expiration
    }

    CACHE_LOCKS {
        varchar key PK
        varchar owner
        int expiration
    }

    JOBS {
        bigint id PK
        varchar queue
        longtext payload
        tinyint attempts
        int reserved_at
        int available_at
        int created_at
    }

    JOB_BATCHES {
        varchar id PK
        varchar name
        int total_jobs
        int pending_jobs
        int failed_jobs
        longtext failed_job_ids
        mediumtext options
        int cancelled_at
        int created_at
        int finished_at
    }

    FAILED_JOBS {
        bigint id PK
        varchar uuid UK
        text connection
        text queue
        longtext payload
        longtext exception
        timestamp failed_at
    }

    TAPIS_MOTIFS ||--o{ MOTIF_OUTFIT : "dipakai outfit"
    OUTFITS ||--o{ MOTIF_OUTFIT : "memakai motif"
